  "api": {
    "implementation": "adapter/web/src/price.rs:514",
    "function": "parse_price",
    "request": {
      "input": "Option<&str>",
      "currency_hint": "Option<&str>",
      "decimal_separator": "Option<char>; None, dot, comma or euro separator; unsupported values collapse to unknown in this wrapper",
      "digit_group_separator": "Option<&str>; exact substring removed before numeric text extraction"
    },
    "response": {
      "amount": "nullable canonical bounded finite decimal string",
      "currency": "nullable source/hint token spelling; not ISO identity",
      "amount_text": "nullable selected source numeric text",
      "amount_float": "nullable finite binary float projection; not observed money"
    },
    "typed_internal": "Price::try_fromstring preserves unsupported-selector AssertionError and ResourceLimit; malformed numeric text becomes absent amount. Separate DecimalAmount/Price constructor, equality and float APIs have other typed errors; the legacy parse_price wrapper returns unknown on errors.",
    "locale": "NO_LOCALE_ARGUMENT; frozen Python3.11/Unicode14-compatible digits/word tables and heuristic separator selection, not geographic/currency disambiguation",
    "bounds": {
      "input_bytes": 4096,
      "hint_bytes": 4096,
      "group_separator_bytes": 64,
      "commerce_numeric_exponent_magnitude": 4096,
      "commerce_numeric_output_bytes": 8192
    },
    "ambiguity": [
      "First selected number may precede the actual price",
      "Sign may be discarded by source-text selection",
      "A free substring may yield derived zero",
      "Currency token spelling does not identify an ISO currency or jurisdiction",
      "Nonfinite or resource-bound decimal projections remain unavailable. Public decimal text has no fixed currency fractional precision; observed-money conversion separately rejects excess precision without rounding."
    ]
  },
