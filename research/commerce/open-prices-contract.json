{
 "api": "Open Prices REST API v1 (read endpoints, no account)",
 "endpoint": "https://prices.openfoodfacts.org/api/v1/",
 "documentation": [
  "https://prices.openfoodfacts.org/api/schema (OpenAPI 3.0.3, read 2026-10-07)",
  "https://github.com/openfoodfacts/open-prices/blob/main/docs/guides/data.md"
 ],
 "request": {
  "products": "products?product_name__like=<name>&price_count__gte=1&order_by=-price_count&size<=50",
  "prices": "prices?product_code=<code>&duplicate_of__isnull=true&order_by=-date&size<=50"
 },
 "terms": {
  "data_licence": "ODbL-1.0 (docs/guides/data.md: mention the source; avoid combining with non-free data that cannot be released as open data)",
  "server_code_licence": "AGPL-3.0, not used: ECDEV only calls the public API",
  "legal_assessment": "NOT_MADE"
 },
 "robots": {
  "prices.openfoodfacts.org": "no robots.txt rules (the single-page app is served at /robots.txt); consulted on every request",
  "world.openfoodfacts.org": "User-agent: * Disallow: /api, so the Open Food Facts product API is not read",
  "search.openfoodfacts.org": "User-agent: * Disallow: /, not read"
 },
 "semantics": [
  "prices are contributed by people in physical stores with a price-tag or receipt photo proof; they are store shelf prices, not online listings or marketplace offers",
  "name search is a substring match: 'oat milk' finds 'Goat Milk'; ECDEV keeps only names holding the query as words",
  "each price row names its contributor account; ECDEV stores only a keyed pseudonym, and several prices from one contributor are one witness",
  "price_per distinguishes item from per-kilogram prices; they are summarised apart",
  "a 13-digit code with a leading zero is a UPC-A"
 ],
