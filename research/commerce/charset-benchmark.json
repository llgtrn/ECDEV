 "findings": [
  "44 of 48 pages on 19 sites decode under a declared encoding or valid UTF-8; all 12 Shift_JIS pages (sofmap.com, hmv.co.jp, kakaku.com, tsukumo.co.jp) declare it, 10 in the HTTP header and 2 in a meta tag within the prescan.",
  "The 4 refused pages are the same 355-byte tsukumo.co.jp 'It moved!!' meta-refresh stub in undeclared Shift_JIS (header text/html without charset, no meta charset); refusing it loses no product evidence.",
  "The statistical detector guessed cp1256 (Arabic) for one hmv.co.jp page that declares Shift_JIS and gave no answer for two others: guessing would have mislabelled pages the declared charset reads correctly.",
  "Several large retailers (yodobashi.com, biccamera.co.jp, oisix.com, tower.jp) did not answer this environment and zozo.jp, hands.net and joshinweb.jp answered robots.txt with 403; they are unsampled, not evidence."
 ],
 "decision": {
  "knowledge": "DELIBERATE_SEMANTIC_DIVERGENCE",
  "runtime": "ECDEV keeps declared-or-strict-UTF-8 decoding with no statistical guessing; an undeclared non-UTF-8 page is refused as INVALID_DOCUMENT_ENCODING",
  "revisit_when": "a targeted source serves product pages in an undeclared legacy encoding"
 },
 "limits": "48 pages on 19 reachable sites, Japanese retail only, one capture time; meta refresh is not followed, so moved pages are measured as the stub they serve",
 "content_encoding": "ECDEV's web client is built without compression features and sends no Accept-Encoding, so servers answer with identity bodies; httpx's gzip, deflate and brotli decoders have no counterpart to need. Compressed sitemaps are refused explicitly (SITEMAP_COMPRESSED_UNSUPPORTED)."
}
