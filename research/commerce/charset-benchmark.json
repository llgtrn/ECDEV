{
 "benchmark": "httpx.content-decoding: how often does ECDEV's strict decoder (BOM, HTTP charset, 1024-byte meta prescan, else strict UTF-8; no statistical guessing) refuse real pages that httpx-style detection would read?",
 "captured_on": "2026-10-07",
 "sites": "25 Japanese retailers (the market where legacy encodings persist); home page plus up to four pages from each robots-declared sitemap; every URL decided by ECDEV's own robots evaluator; ECDEV user agent; 1.5 s between requests",
 "instrument": "ECDEV's adapter/web document::decode for every body (helper below); charset_normalizer 3.5.2, the detector httpx uses, only for comparison",
 "evidence_state": "BENCHMARK_MEASUREMENT of document encodings at one time; not evidence about any product or market",
 "harness_sources": {
  "tools/commerce/charset_benchmark.py": "6f6c7272e39db699c1a10ed1df6c6d226c09d4b7677dd2916656c0be744e57e2",
  "helper (fetch-mode harness ecdev_side, decode mode)": "//! ECDEV side of the fetch-mode benchmark, using ECDEV's own code paths.\n//!   robots <robots.txt file or -> <url>   -> prints {\"allowed\":bool,\"crawl_delay\":f64|null}\n//!   extract <html file> <content-type> <url> -> prints the products ECDEV extracts\nuse serde_json::{Value, json};\nfn main() {\n    let a: Vec<String> = std::env::args().collect();\n    match a[1].as_str() {\n        \"robots\" => {\n            let text = if a[2] == \"-\" { String::new() } else { std::fs::read_to_string(&a[2]).unwrap() };\n            let d = ecdev_web::robots::evaluate(&text, &a[3], \"ECDEV\");\n            println!(\"{}\", json!({\"allowed\": d.allowed, \"crawl_delay\": d.crawl_delay_seconds, \"evidence\": d.evidence}));\n        }\n        \"extract\" => {\n            let bytes = std::fs::read(&a[2]).unwrap();\n            let out = match ecdev_web::document::extract(&bytes, &a[3], &a[4]) {\n                Ok(v) => {\n                    let products: Vec<Value> = v[\"products\"].as_array().into_iter().flatten().map(|p| json!({\n                        \"title\": p[\"title\"], \"sku\": p[\"sku\"], \"price_minor\": p[\"price_minor\"], \"currency\": p[\"currency\"],\n                        \"availability\": p[\"availability\"], \"price_source\": p[\"price\"][\"source\"].clone(), \"relation\": p[\"page_relation\"][\"relation\"].clone(),\n                    })).collect();\n                    json!({\"ok\": true, \"products\": products, \"page_role\": v[\"page_role\"]})\n                }\n                Err(e) => json!({\"ok\": false, \"error\": e}),\n            };\n            println!(\"{out}\");\n        }\n        \"decode\" => {\n            let bytes = std::fs::read(&a[2]).unwrap();\n            let out = match ecdev_web::document::decode(&bytes, &a[3]) {\n                Ok((_, recipe)) => json!({\"ok\": true, \"recipe\": recipe}),\n                Err(e) => json!({\"ok\": false, \"error\": e}),\n            };\n            println!(\"{out}\");\n        }\n        _ => panic!(\"mode\"),\n    }\n}\n"
 },
 "summary": {
