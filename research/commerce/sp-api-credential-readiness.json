{
  "status": "LIVE_AUTH_BLOCKED_BY_CREDENTIALS",
  "review_date": "2026-10-06",
  "scope": "Official Amazon SP-API boundary made credential-ready; no live calls, no credentials, no fabricated live evidence",
  "new_live_acquisition": false,
  "live_calls_made": 0,
  "credentials_present_in_review_environment": false,
  "credentials_read": false,
  "blocker": {
    "code": "LIVE_AUTH_BLOCKED_BY_CREDENTIALS",
    "meaning": "SP_API_CLIENT_ID / SP_API_CLIENT_SECRET (app credentials) and SP_API_REFRESH_TOKEN (seller authorization) are absent; no LWA token was ever requested",
    "unblock_requires": [
      "Registered SP-API application credentials (SP_API_CLIENT_ID, SP_API_CLIENT_SECRET)",
      "Seller-authorized refresh token (SP_API_REFRESH_TOKEN) with roles for each operation",
      "ECDEV_SPAPI_ALLOW_LIVE_READ=true (explicit operator gate)",
      "ECDEV_SPAPI_HTTP_REQUEST_LIMIT in 1..1000",
      "For ecdev.product.analyze live: explicit core USD per-run/day/month/provider/capability and request ceilings > 0"
    ]
  },
  "doctor": {
    "cli": "ecdev doctor sp-api",
    "cli_summary": "ecdev doctor (official_sp_api.status)",
    "mcp_tool": "ecdev.provider.doctor",
    "mcp_input": {
      "provider": "amazon-sp-api (default)"
    },
    "implementation": [
      "adapter/marketplace/src/doctor.rs",
      "adapter/marketplace/src/transport.rs::ConfiguredAmazon::doctor_report",
      "domain/commerce/src/provider.rs::Provider::doctor",
      "domain/commerce/src/marketplace/runtime.rs::Engine::provider_doctor",
      "apps/server/src/lib.rs::doctor_command"
    ],
    "reports_independently": [
      "app_credentials (SP_API_CLIENT_ID, SP_API_CLIENT_SECRET: PRESENT|MISSING)",
      "seller_authorization (SP_API_REFRESH_TOKEN: PRESENT|MISSING)",
      "marketplace (ECDEV_SPAPI_MARKETPLACE optional default; SELECTED_PER_REQUEST when unset)",
      "operator_gate (ECDEV_SPAPI_ALLOW_LIVE_READ: ON|OFF)",
      "request_budget (ECDEV_SPAPI_HTTP_REQUEST_LIMIT, session attempts/remaining)",
      "core_monetary_ceiling (engine budget policy)",
      "endpoints per region (NA, FE allowlisted; EU NOT_SUPPORTED_BY_ADAPTER; LWA) with network_probe NOT_PERFORMED",
      "token_state (NEVER_REQUESTED | VALID_IN_MEMORY | EXPIRED_RENEWAL_REQUIRED | LAST_REFRESH_FAILED | LWA_COOLDOWN)",
      "operations available vs blocked with blocked_by reasons",
      "restricted_domain RESTRICTED_DOMAIN_DISABLED, writes WRITES_DISABLED"
    ],
    "overall_statuses": [
      "LIVE_AUTH_BLOCKED_BY_CREDENTIALS",
      "LIVE_READ_BLOCKED_BY_OPERATOR_GATE",
      "LIVE_READ_BLOCKED_BY_REQUEST_BUDGET",
      "LIVE_READ_BLOCKED_BY_REQUEST_BUDGET_EXHAUSTED",
      "LIVE_AUTH_BLOCKED_BY_INVALID_CREDENTIALS",
      "LIVE_SESSION_NOT_CONFIGURED_RESTART_REQUIRED",
      "OFFICIAL_HTTP_CLIENT_UNAVAILABLE",
      "LWA_COOLDOWN",
      "LIVE_READ_CONFIGURED_UNVERIFIED"
    ],
    "observed_status_in_review_environment": "LIVE_AUTH_BLOCKED_BY_CREDENTIALS",
    "secret_policy": {
      "presence_detection": "std::env::var_os(key).is_some() existence only; values never read by doctor",
      "secret_values_read": "Only by ConfiguredAmazon::from_source after operator gate ON and request budget valid",
      "output": "No values, lengths, prefixes, suffixes or masked forms of secrets; tokens memory-only and never persisted",
      "env_injection": "EnvSource trait (ProcessEnv, MapEnv) so tests never call std::env::set_var"
    },
    "tests": [
      "adapter/marketplace doctor::tests::doctor_without_credentials_blocks_live_auth_and_reads_no_secrets",
      "adapter/marketplace doctor::tests::doctor_gate_precedes_secret_reads_and_output_never_contains_secret_values",
      "adapter/marketplace doctor::tests::non_secret_settings_never_expose_secret_keys",
      "adapter/marketplace transport::tests::official_token_state_transitions_are_reported_without_material",
      "apps/server doctor_tests::doctor_sp_api_cli_and_mcp_report_blocked_credentials_without_secrets"
    ]
