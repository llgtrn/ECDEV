 "findings": [
  "Over 21 HTML pages captured twice 180 s apart, the raw bytes differed on 21 (per-response tokens, nonces and build identifiers), so a raw-byte monitor alerts on every check.",
  "ECDEV's visible text differed on 0 of them: on these pages a visible-text fingerprint has no false positive at this interval.",
  "The three ikea.com URLs came from a sitemap that lists product pages under /p/; they are counted and labelled, and behave the same.",
  "uniqlo.com answered 403 to all six page requests in this run (it served product pages to the same agent earlier the same day) and is excluded."
 ],
 "decision": {
  "knowledge": "INDEPENDENT_NATIVE",
  "native": [
   "adapter/web/src/page_text.rs (visible_lines, summary)",
   "domain/commerce/src/monitor.rs (page_text in watch snapshots for pages without products; PAGE_TEXT_CHANGED with added and removed lines as multisets)"
  ],
  "rejected": "raw-byte change detection"
 },
 "limits": "21 pages, one 180 s interval, one capture time; genuine text changes (edited terms) were not observed live and are covered by tests; longer intervals may show rotating banners or dates as text changes"
}
