  "generator": "One-off Python run over the fetched index-*.txt files writing dense little-endian u32 arrays (0xFFFFFFFF = unmapped; single-byte tables padded to 128; gb18030 ranges as (pointer, code point) pairs) and the label table from encodings.json into adapter/web/src/text_decoding_labels.rs.",
  "decoders": "adapter/web/src/text_decoding.rs: UTF-8, UTF-16LE/BE, 28 single-byte encodings, x-user-defined, replacement, GBK/gb18030, Big5, EUC-JP, Shift_JIS, ISO-2022-JP, EUC-KR. Encoders are deliberately absent.",
  "differential_proof": {
    "oracle": "encoding_rs 0.8.35 (the version ECDEV pinned) decode_without_bom_handling",
    "inputs": "for each of 44 labels: empty input, all 256 one-byte inputs, all 65536 two-byte inputs, 300000 seeded multi-byte inputs (3-10 bytes, biased to lead, digit and ASCII bytes)",
    "result": "text and error flag identical on every input; a first run found one real difference (UTF-16 lead surrogate followed by an odd trailing byte reported two errors where the standard reports one) which was fixed before the digests were frozen",
    "frozen_fixture": "adapter/web/tests/fixtures/charset-differential-digest.json",
    "frozen_fixture_sha256": "bacda7aad54b47600ef8a29e57fb01d30b773e5f5efe4ad2e21b2be2b1695c06",
    "post_removal_test": "adapter/web/tests/charset_parity.rs recomputes the native digests and compares them with the frozen ones; encoding_rs is no longer a dependency"
  },
