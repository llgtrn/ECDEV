{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "market": {
      "enum": [
        "AMAZON_JP",
        "AMAZON_US",
        "PUBLIC_WEB"
      ]
    },
    "query": {
      "type": "string",
      "maxLength": 500
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string"
          },
          "fixture_html": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    "max_pages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "min_price_minor": {
      "type": "integer",
      "minimum": 0
    },
    "max_price_minor": {
      "type": "integer",
      "minimum": 0
    },
    "economics": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "selling_price": {
          "type": "integer",
          "minimum": 1
        },
        "product_cost": {
          "type": "integer",
          "minimum": 0
        },
        "packaging": {
          "type": "integer",
          "minimum": 0
        },
        "sample_amortization": {
          "type": "integer",
          "minimum": 0
        },
        "freight": {
          "type": "integer",
          "minimum": 0
        },
        "insurance": {
          "type": "integer",
          "minimum": 0
        },
        "duty": {
          "type": "integer",
          "minimum": 0
        },
        "import_tax": {
          "type": "integer",
          "minimum": 0
        },
        "brokerage": {
          "type": "integer",
          "minimum": 0
        },
        "prep": {
          "type": "integer",
          "minimum": 0
        },
        "label": {
          "type": "integer",
          "minimum": 0
        },
        "fulfillment_fee": {
          "type": "integer",
          "minimum": 0
        },
        "referral_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "storage_fee": {
          "type": "integer",
          "minimum": 0
        },
        "payment_cost": {
          "type": "integer",
          "minimum": 0
        },
        "ppc": {
          "type": "integer",
          "minimum": 0
        },
        "returns": {
          "type": "integer",
          "minimum": 0
        },
        "fx_cost": {
          "type": "integer",
          "minimum": 0
        },
        "reserve": {
          "type": "integer",
          "minimum": 0
        },
        "units": {
          "type": "integer",
          "minimum": 1
        },
        "fixed_launch_cost": {
          "type": "integer",
          "minimum": 0
        },
        "lead_time_days": {
          "type": "integer",
          "minimum": 0
        },
        "inventory_days": {
          "type": "integer",
          "minimum": 0
        },
        "payout_days": {
          "type": "integer",
          "minimum": 0
        },
        "supplier_credit_days": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "fulfillment": {
          "type": "string",
          "enum": [
            "FBA",
            "FBM",
            "EPROLO_DROPSHIP",
            "THREE_PL",
            "BULK_IMPORT",
            "FACTORY_DIRECT"
          ]
        }
      },
      "required": [
        "currency",
        "fulfillment",
        "selling_price",
        "product_cost",
        "fulfillment_fee",
        "referral_bps",
        "units"
      ],
      "additionalProperties": false
    },
    "allow_stale": {
      "type": "boolean",
      "default": false
    },
    "max_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "default": 3
    },
    "max_urls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000,
      "default": 2000
    },
    "deadline_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600,
      "default": 600
    },
    "crawl_run_id": {
      "type": "string",
      "description": "Resume a persisted crawl, recovering handled captures and expired leases; original crawl limits remain in force"
    },
    "force_refresh": {
      "type": "boolean",
      "default": false,
      "description": "Acquire a new body even when a fresh cache entry exists; bounded public fetching and robots rules still apply"
    },
    "follow_up_run_id": {
      "type": "string",
      "description": "Execute selected zero-paid information-gain actions from a persisted non-fixture run; omit sources and crawl_run_id. Robots and frontier budgets still apply."
    }
  },
  "required": [
    "market",
    "query"
  ],
  "oneOf": [
    {
      "required": [
        "sources"
      ],
      "not": {
        "required": [
          "follow_up_run_id"
        ]
      }
    },
    {
      "required": [
        "follow_up_run_id"
      ],
      "not": {
        "required": [
          "sources"
        ]
      }
    }
  ]
}
