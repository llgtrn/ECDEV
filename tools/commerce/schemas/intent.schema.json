{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "capital": {
      "type": "integer",
      "minimum": 1
    },
    "min_price": {
      "type": "integer",
      "minimum": 1
    },
    "max_price": {
      "type": "integer",
      "minimum": 1
    },
    "max_weight_g": {
      "type": "integer",
      "minimum": 1
    },
    "max_inventory_per_sku": {
      "type": "integer",
      "minimum": 1
    },
    "market": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "minimum_margin_bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "positive_trend": {
      "type": "boolean"
    },
    "exclude_regulated": {
      "type": "boolean"
    }
  },
  "required": [
    "capital",
    "min_price",
    "max_price",
    "max_weight_g",
    "max_inventory_per_sku",
    "market",
    "currency",
    "minimum_margin_bps"
  ],
  "additionalProperties": false
}
