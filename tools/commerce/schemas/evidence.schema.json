{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "external_source": {
      "type": "string",
      "minLength": 1
    },
    "market": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "retrieved_at": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "LIVE",
        "CACHED",
        "REPLAY",
        "FIXTURE",
        "SIMULATED",
        "INFERRED"
      ]
    },
    "raw_hash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "query": {},
    "normalized_value": {},
    "currency": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "freshness_seconds": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "cost_minor": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "required": [
    "id",
    "source_type",
    "provider",
    "external_source",
    "market",
    "timestamp",
    "retrieved_at",
    "unit",
    "run_id",
    "mode",
    "raw_hash",
    "query",
    "normalized_value",
    "currency",
    "confidence",
    "freshness_seconds",
    "cost_minor"
  ],
  "additionalProperties": false
}
